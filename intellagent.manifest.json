{
  "appName": "Intellagent",
  "host": "127.0.0.1",
  "port": 7420,
  "dataDir": "./data",
  "defaultBoard": "main",
  "defaultAgent": "claude",
  "lease": {
    "defaultMinutes": 30,
    "maxMinutes": 1440,
    "warningMinutes": 5
  },
  "presenceTimeoutSeconds": 90,
  "readonlyData": true,
  "backups": 10,
  "auth": {
    "requireAgentTokens": true
  },
  "approvalsOff": true,
  "permissions": {
    "claude": {
      "grants": [
        {
          "power": "review.decide"
        }
      ]
    }
  },
  "metrics": {
    "prometheus": true
  },
  "allowedHosts": [
    "host.docker.internal"
  ]
}
